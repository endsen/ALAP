{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alap.invalid/contracts/command.schema.json",
  "title": "ALAP command v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "experiment_id",
    "run_id",
    "task_id",
    "instrument_id",
    "lease_id",
    "fencing_token",
    "policy_version",
    "skill_id",
    "parameters",
    "deadline_at",
    "issued_at",
    "authorized_plan_hash",
    "capability_version",
    "control_epoch",
    "skill_version"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "command_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "instrument_id": {
      "type": "string",
      "minLength": 1
    },
    "lease_id": {
      "type": "string",
      "minLength": 1
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "skill_id": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true
    },
    "deadline_at": {
      "type": "string",
      "format": "date-time"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "authorized_plan_hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "capability_version": {
      "type": "string",
      "minLength": 1
    },
    "command_signature": {
      "type": "string"
    },
    "control_epoch": {
      "type": "string",
      "format": "uuid"
    },
    "skill_version": {
      "type": "string",
      "minLength": 1
    }
  }
}
