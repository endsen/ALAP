{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alap.invalid/contracts/plan_task.schema.json",
  "title": "ALAP plan_task v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "resource_id",
    "required_resources",
    "skill_ref",
    "parameters",
    "depends_on",
    "preconditions",
    "success_condition",
    "timeout_s"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "resource_id": {
      "type": "string",
      "minLength": 1
    },
    "required_resources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "skill_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*@[1-9][0-9]*$"
    },
    "parameters": {
      "type": "object"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "preconditions": {
      "type": "array",
      "items": {
        "$ref": "stable_condition.schema.json"
      }
    },
    "success_condition": {
      "oneOf": [
        {
          "$ref": "stable_condition.schema.json"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "dataset_committed"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "readback_verified"
            }
          }
        }
      ]
    },
    "timeout_s": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    }
  }
}
